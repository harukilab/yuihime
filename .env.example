# =========================================================================
# YUIHIME ARCHITECTURE CORE ENVIRONMENT BLUEPRINT (.env.example)
# =========================================================================

# -------------------------------------------------------------------------
# 1. Core AI Providers API Keys (Empty by default)
# -------------------------------------------------------------------------
# Core Gemini API Key (Server-side ONLY, do not expose to client)
GEMINI_API_KEY=

# OpenRouter API Key for multi-provider cognitive resilience
OPENROUTER_API_KEY=

# -------------------------------------------------------------------------
# 2. Storage & Outer Data Directory Mapping
# -------------------------------------------------------------------------
# Core directory containing all dynamic runtime files (Default: .yuihime if empty)
YUIHIME_SYSTEM_ROOT=

# -------------------------------------------------------------------------
# 3. Security Sandbox & Command execution (YOLO Modes)
# -------------------------------------------------------------------------
# Mode controls level of sandbox enforcement: 'full' (all-in OS), 'half' (monitored OS), 'off' (jailed)
# If empty, the system defaults to 'off'
YUIHIME_YOLO_MODE=

# -------------------------------------------------------------------------
# 4. Server Infrastructure (Nginx proxy / Container settings)
# -------------------------------------------------------------------------
# App runtime listening port (AI Studio environment strictly requires 3000)
PORT=3000
