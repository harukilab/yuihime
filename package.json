{
  "name": "yuihime",
  "private": true,
  "version": "4.279",
  "description": "YuiHime AI Engine - autonomous trans-dimensional virtual companion (AGI) with multi-provider LLM gateway, cognitive cortex, and multi-channel bridges.",
  "type": "module",
  "bin": "dist/server.cjs",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation tsx server.ts",
    "dev:web": "NODE_OPTIONS=--no-deprecation vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "NODE_OPTIONS=--no-deprecation vite build --config web/vite.config.ts --emptyOutDir",
    "build:server": "tsx src/bin/generate-build-info.ts && esbuild server.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:esbuild --external:vite --external:lightningcss --external:abort-controller --alias:punycode=./src/shims/punycode.cjs --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_OPTIONS=--no-deprecation node dist/server.cjs",
    "build:bin": "node src/bin/compile-binary.cjs",
    "build:bundle": "node src/bin/compile-binary.cjs",
    "build:bin:server": "node src/bin/compile-binary.cjs --server-only",
    "build:bin:web": "node src/bin/compile-binary.cjs --web-only",
    "otome": "tsx otome/cli.ts",
    "otome:tg": "tsx otome/tg_bot.ts",
    "debug": "bash tools/yui-debug.sh",
    "debug:start": "bash tools/yui-debug.sh start",
    "debug:stop": "bash tools/yui-debug.sh stop",
    "debug:status": "bash tools/yui-debug.sh status",
    "debug:logs": "bash tools/yui-debug.sh logs",
    "lint": "tsc --noEmit"
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "shared/**/*",
      "web/dist/**/*",
      "src/share/prompts/**/*",
      "!src/share/prompts/build-info.json"
    ],
    "targets": [
      "node20-linux-x64",
      "node20-linux-arm64",
      "node20-win-x64",
      "node20-macos-x64",
      "node20-macos-arm64"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pixiv/three-vrm": "^3.5.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "d3": "^7.9.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "smol-toml": "^1.6.1",
    "telegraf": "^4.16.3",
    "tesseract.js": "^7.0.0",
    "three": "^0.184.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.21.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "allowScripts": {
    "@google/genai": true,
    "better-sqlite3": true,
    "esbuild": true,
    "protobufjs": true
  }
}
